	rightValue := calculateWordValue(rightWord, assignment)
	
	if sum == rightValue {
		return assignment
	}
	
	return nil
}

func calculateWordValue(word string, assignment map[rune]int) int {
	value := 0
	for _, c := range word {
		digit := assignment[c]
		value = value*10 + digit
	}
	return value
}
