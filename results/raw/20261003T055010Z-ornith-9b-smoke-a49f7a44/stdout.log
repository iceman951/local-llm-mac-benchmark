class StackUnderflowError(Exception):
    pass


def evaluate(input_data):
    stack = []
    words = {}
    
    # Split input into tokens
    tokens = input_data.replace('\n', ' ').split()
    
    i = 0
    while i < len(tokens):
        token = tokens[i]
        
        # Handle word definition
        if token == ':':
            # Find the end of definition
            j = i + 1
            while j < len(tokens) and tokens[j] != ';':
                j += 1
            
            if j >= len(tokens):
                raise SyntaxError("Incomplete definition")
            
            name = tokens[j]
            definition = tokens[i+1:j]
            
            # Check if name is a number
            if name.isdigit() or (name.startswith('-') and name[1:].isdigit()):
                raise ValueError("Word name cannot be a number")
            
            # Store the definition
            words[name.lower()] = definition
            
            i = j + 1
            continue
        
        # Handle numbers
        if token.isdigit() or (token.startswith('-') and token[1:].isdigit()):
            stack.append(int(token))
            i += 1
            continue
        
        # Handle built-in words
        token_lower = token.lower()
        
        if token_lower == '+':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in 
stack")
            b = stack.pop()
            a = stack.pop()
            stack.append(a + b)
            i += 1
            continue
        
        elif token_lower == '-':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in 
stack")
            b = stack.pop()
            a = stack.pop()
            stack.append(a - b)
            i += 1
            continue
        
        elif token_lower == '*':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in 
stack")
            b = stack.pop()
            a = stack.pop()
            stack.append(a * b)
            i += 1
            continue
        
        elif token_lower == '/':
            if len(stack) < 2:
                raise StackUnderflowError("Insufficient number of items in 
stack")
            b = stack.pop()
            a = stack.pop()
            if b == 0:
                raise ZeroDivisionError("divide by zero")
            stack.append(a // b)
            i += 1
            continue
        
        elif token_lower == 'dup':
            if len(stack) < 1:
                raise StackUnderflowError("Insufficient number of items in 
