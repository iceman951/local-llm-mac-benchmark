```go
package alphametics

import (
        "fmt"
        "strings"
        "unicode"
)

func Solve(puzzle string) (map[string]int, error) {
        // Parse the puzzle
        parts := strings.Split(puzzle, "==")
        if len(parts) != 2 {
                return nil, fmt.Errorf("invalid puzzle format")
        }
        
        leftSide := strings.TrimSpace(parts[0])
        rightSide := strings.TrimSpace(parts[1])
        
        // Split left side by +
        addends := strings.Split(leftSide, "+")
        
        // Extract words and letters
        var words []string
        allLetters := make(map[rune]bool)
        
        for _, word := range addends {
                word = strings.TrimSpace(word)
                if word == "" {
                        continue
                }
                words = append(words, word)
                for _, ch := range word {
                        if unicode.IsLetter(ch) {
                                allLetters[ch] = true
                        }
                }
        }
        
        resultWord := strings.TrimSpace(rightSide)
        if resultWord == "" {
                return nil, fmt.Errorf("no result word")
        }
        
        for _, ch := range resultWord {
                if unicode.IsLetter(ch) {
                        allLetters[ch] = true
                }
        }
        
        // Get all unique letters
        letters := make([]rune, 0, len(allLetters))
        for ch := range allLetters {
                letters = append(letters, ch)
        }
        
        if len(letters) > 10 {
                return nil, fmt.Errorf("too many unique letters")
        }
        
        // Identify leading letters
        leadingLetters := make(map[rune]bool)
        for _, word := range words {
                if len(word) > 0 {
                        leadingLetters[word[0]] = true
                }
        }
        leadingLetters[resultWord[0]] = true
        
        // Convert words to their letter sequences
        wordLetters := make([][]rune, len(words)+1)
        for i, word := range words {
                wordLetters[i] = []rune(word)
        }
        wordLetters[len(words)] = []rune(resultWord)
        
        // Backtracking solver
        digits := make([]int, len(letters))
        usedDigits := make([]bool, 10)
        
        var solve func(idx int) error
        solve = func(idx int) error {
                if idx == len(letters) {
                        // Check the equation
                        // Calculate sum of addends
                        sum := 0
                        for i := 0; i < len(words); i++ {
                                val := 0
                                for j, ch := range wordLetters[i] {
                                        val += int(digits[letters[ch-'A']]) * 
intPow(10, len(wordLetters[i])-1-j)
                                }
                                sum += val
                        }
                        
                        // Calculate result
                        resultVal := 0
                        for j, ch := range wordLetters[len(words)] {
                                resultVal += int(digits[letters[ch-'A']]) * 
intPow(10, len(wordLetters[len(words)])-1-j)
                        }
                        
                        if sum == resultVal {
                                return nil
                        }
                        return fmt.Errorf("no solution")
                }
                
                ch := letters[idx]
                for d := 0; d <= 9; d++ {
                        if d == 0 && leadingLetters[ch] {
                                continue
                        }
                        digits[idx] = d
                        if err := solve(idx + 1); err == nil {
                                return nil
                        }
                }
                return fmt.Errorf("no solution")
        }
        
        if err := solve(0); err != nil {
                return nil, err
        }
        
        // Build result map
        result := make(map[string]int)
        for i, ch := range letters {
                result[string(ch)] = digits[i]
        }
        
        return result, nil
}

func intPow(base, exp int) int {
        result := 1
        for i := 0; i < exp; i++ {
                result *= base
        }
        return result
}
